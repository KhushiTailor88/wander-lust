<% layout('/layout/boilerplate') %>
<body>
<form method="POST" action="/login" novalidate class="needs-validation">
        <div class="mb-3 col-6 offset-3">
            <label for="username" class="form-label">username</label>
            <input placeholder="Your username" name="username" type="text" class="form-control" required>
            <div class="valid-feedback">Looks good</div>
            
            <label for="password" class="form-label">password</label>
            <input placeholder="Your password" 
            name="password" 
            type="password"
             class="form-control" required>
            <div class="valid-feedback">Looks good</div>
         <button class="btn btn-dark offset-4 mt-2">login</button>   
        </div>
        </form>
        </body>
